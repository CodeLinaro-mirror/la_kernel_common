    {
      "key": {
        "uuid": "a313a5f9_9085e034",
        "filename": "include/linux/filter.h",
        "patchSetId": 3
      },
      "lineNbr": 549,
      "author": {
        "id": 1058768
      },
      "writtenOn": "2019-09-18T22:54:33Z",
      "side": 1,
      "message": "\u003e hmm, thinking about it more there\u0027s a bunch of func calls in here which aren\u0027t checked.\n\nWhich functions do you mean? Unless the function has the __nocfi attribute, all indirect calls in the function are checked when CFI is enabled. Direct function calls don\u0027t need checking and CFI doesn\u0027t add any instrumentation to them.",
      "parentUuid": "2124711a_f55ec4d7",
      "range": {
        "startLine": 549,
        "startChar": 0,
        "endLine": 549,
        "endChar": 48
      },
      "revId": "199d7fa6623c8d6a3a7ee78a4def942b7ba0b818",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
