        "id": 1000205
      },
      "writtenOn": "2018-08-17T19:06:18Z",
      "side": 1,
      "message": "This is not safe. When you return an error here the previous data you put in the return buffer is discarded.",
      "revId": "38c869776aa1b2b45b173edb8c333b2b16799108",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
