    {
      "key": {
        "uuid": "15172eb6_0e8b4975",
        "filename": "kernel/sched/tune.c",
        "patchSetId": 1
      },
      "lineNbr": 333,
      "author": {
        "id": 1119068
      },
      "writtenOn": "2018-02-13T16:11:38Z",
      "side": 1,
      "message": "This function is used to update boostgroups accounting when we change a boost value via the sysfs interface. The most frequent case is a touchboost event. However, we should consider that we do not trigger schedutil at this point... we need to wait the next enqueue/tick event.\n\nThis, I would say that we can skip timeout updates from this code path (provided also we use a max aggregation instead of the closes one) and keep instead the original code. Which mean: boost timeout will be managed just by the fast path at the next enqueue/dequeue event.",
      "revId": "7a2ae52abcc8cf60b8c1b0413eace0411dd7656d",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "5590af95_6537d5a8",
        "filename": "kernel/sched/tune.c",
