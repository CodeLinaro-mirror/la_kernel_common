        "filename": "drivers/android/binder.c",
        "patchSetId": 2
      },
      "lineNbr": 437,
      "author": {
        "id": 1125653
      },
      "writtenOn": "2017-04-15T09:01:55Z",
      "side": 1,
      "message": "Don\u0027t use BUG_ON for coding \"contracts\", as we never want to crash a kernel.",
      "range": {
        "startLine": 437,
        "startChar": 1,
        "endLine": 437,
        "endChar": 7
      },
      "revId": "dd95689bb9ec502baec36033b5a3895d06f77057",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
