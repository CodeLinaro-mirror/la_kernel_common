      "writtenOn": "2017-04-15T09:01:55Z",
      "side": 1,
      "message": "crash the whole system?  Isn\u0027t that a bit harsh?",
      "range": {
        "startLine": 398,
        "startChar": 1,
        "endLine": 398,
        "endChar": 7
      },
      "revId": "dd95689bb9ec502baec36033b5a3895d06f77057",
